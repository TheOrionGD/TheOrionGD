# ==============================================================================
# TheOrionGD - Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# Database Connection (MongoDB)
# If running locally or encountering SRV DNS resolution timeouts, use a standard non-SRV URI.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=portfolio_db

# Authentication & Admin Security
# Generate a strong, random secret key for signing JWTs in production
JWT_SECRET=oriongd_secret_key_change_me_in_production
ADMIN_COOKIE_NAME=oriongd_admin_token

# AI Intelligence & Chatbot
# GROQ API Key for fast LLM inference
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
# Gemini API Key (Optional client/build integration)
GEMINI_API_KEY=your_gemini_api_key_here

# Lead Email Notifications (Brevo SMTP Relay)
SMTP_SERVER=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_LOGIN=b463ca001@smtp-brevo.com
BREVO_SMTP_KEY=xsmtpsib-your_brevo_smtp_key_here
ADMIN_NOTIFICATION_EMAIL=godfreytr.prof@gmail.com
SENDER_EMAIL=godfreytr.prof@gmail.com

# Server Environment
PORT=3001
NODE_ENV=development
APP_URL=https://the-orion-gd.vercel.app

# ==============================================================================
